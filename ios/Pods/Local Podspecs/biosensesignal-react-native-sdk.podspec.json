{
  "name": "biosensesignal-react-native-sdk",
  "version": "5.9.3",
  "summary": "BiosenseSignal React Native SDK",
  "platforms": {
    "ios": "14.0"
  },
  "authors": {
    "BiosenseSignal": ""
  },
  "homepage": "https://biosensesignal.com",
  "license": {
    "file": "./LICENSE.txt"
  },
  "source": {
    "path": "."
  },
  "source_files": "ios/**/*.{h,m,mm,swift}",
  "dependencies": {
    "React-Core": [

    ],
    "React-Codegen": [

    ],
    "RCT-Folly": [

    ],
    "RCTRequired": [

    ],
    "RCTTypeSafety": [

    ],
    "ReactCommon/turbomodule/core": [

    ]
  },
  "vendored_frameworks": "BiosenseSignal.xcframework",
  "compiler_flags": "-DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1 -Wno-comma -Wno-shorten-64-to-32 -DRCT_NEW_ARCH_ENABLED=1",
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "\"$(PODS_ROOT)/boost\"",
    "OTHER_CPLUSPLUSFLAGS": "-DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++17"
  }
}
